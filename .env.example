# POSEIDON AI Environment Configuration

# Project Metadata
PROJECT_NAME="POSEIDON AI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# Default to SQLite for zero-configuration local execution and testing.
# For production PostgreSQL/PostGIS: postgresql+asyncpg://poseidon:poseidon@localhost:5432/poseidon_db
DATABASE_URL="sqlite+aiosqlite:///./poseidon.db"
DATABASE_ECHO=false

# Offline Geospatial Bounds (Coimbatore Noyyal Corridor)
GEO_MIN_LAT=10.9000
GEO_MAX_LAT=11.1000
GEO_MIN_LON=76.8500
GEO_MAX_LON=77.1500

# Authentication & Ingestion Secrets
DEFAULT_HMAC_SECRET="poseidon-pre-shared-hmac-secret-key-32b!"
REPLAY_WINDOW_SIZE=64
MAX_FUTURE_TIMESTAMP_DRIFT_SEC=300

# Optimization (OR-Tools)
OPTIMIZER_FAIRNESS_THETA=0.5
OPTIMIZER_TIME_LIMIT_SEC=10

# AI / LLM Configuration (Optional offline Ollama or Gemini)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:7b"
GEMINI_API_KEY=""

