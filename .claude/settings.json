{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git stash*)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(curl *)",
      "Bash(make *)",
      "Bash(pytest *)",
      "Bash(vitest *)",
      "Bash(jest *)",
      "Bash(prisma *)",
      "Bash(alembic *)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(*deploy*)",
      "Bash(*publish*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(ufw *)",
      "Bash(iptables *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown *)",
      "Bash(systemctl *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/**)",
      "Edit(/etc/**)",
      "Write(/etc/**)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git branch -D main)",
      "Bash(git branch -D master)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(fdisk*)",
      "Bash(parted*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*id_rsa*)",
      "Read(**/*id_ed25519*)",
      "Read(**/credentials*)"
    ]
  }
}
